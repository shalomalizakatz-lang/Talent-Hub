# Postgres connection string
DATABASE_URL=postgres://talent_hub:talent_hub@localhost:5432/talent_hub

# Session cookie signing secret — generate a long random string
SESSION_SECRET=change-me-to-a-long-random-string

# Shared password gating the whole app (single login, no per-user accounts)
SHARED_PASSWORD=change-me

PORT=4000
NODE_ENV=development

# Resume size cap in bytes (default 10MB)
MAX_UPLOAD_BYTES=10485760

# --- Object storage (S3-compatible: AWS S3, Cloudflare R2, Supabase Storage) ---
# Leave these blank to use local-disk storage under server/uploads for local
# development only. Production MUST set these — resumes are never stored
# in Postgres.
S3_BUCKET=
S3_REGION=auto
# For AWS S3 leave S3_ENDPOINT blank. For R2/Supabase/other S3-compatible
# providers, set the endpoint URL they give you.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL resumes are served from (e.g. a CDN domain or bucket URL).
S3_PUBLIC_BASE_URL=
# Set to true for providers that require path-style addressing (e.g. some R2/minio setups).
S3_FORCE_PATH_STYLE=false

# --- Email (Resend) ---
# Leave blank to skip sending — the app logs and continues instead of
# failing. Set both to enable the "employer notified on match approval"
# email. RESEND_FROM_EMAIL must be an address on a domain verified in
# your Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
